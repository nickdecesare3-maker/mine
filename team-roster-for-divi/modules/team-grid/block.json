{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "team-roster-for-divi/team-grid",
	"title": "Team Grid",
	"category": "widgets",
	"icon": "groups",
	"description": "Automatically lay out your Team Member posts as a responsive grid of Team Member Cards, optionally grouped into labeled sections.",
	"keywords": [ "team", "staff", "grid", "divi", "roster" ],
	"textdomain": "team-roster-for-divi",
	"attributes": {
		"displayMode": { "type": "string", "default": "all" },
		"groupIds": { "type": "array", "default": [], "items": { "type": "number" } },
		"excludeIds": { "type": "array", "default": [], "items": { "type": "number" } },
		"sortOrder": { "type": "string", "default": "menu_order" },
		"groupSections": { "type": "boolean", "default": false },
		"columns": { "type": "number", "default": 3 },
		"columnsTablet": { "type": "number", "default": 2 },
		"columnsMobile": { "type": "number", "default": 1 },
		"buttonLabel": { "type": "string", "default": "Read Bio" },
		"cardBackground": { "type": "string", "default": "" },
		"cardTextColor": { "type": "string", "default": "" },
		"cardRadius": { "type": "number", "default": 8 }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./build/index.js",
	"style": "file:../../assets/css/card.css",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:../../assets/js/modal.js",
	"viewStyle": "file:../../assets/css/modal.css"
}
